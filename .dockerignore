# any level of node modules
node_modules
**/node_modules
packages/**/node_modules
apps/**/node_modules
packages/**/dist
apps/**/dist

# dotenv at any level
.env
apps/**/.env

# this should be copied from `out` which is generated by: turbo prune @igniter/<app> --docker
apps
packages

# Secrets and local state must never enter the build context: dotenv files at
# any depth (including the pruned out/ tree), session scratch, VCS metadata.
**/.env
**/.env.*
**/.local
.git
**/.git
.claude
**/.claude
