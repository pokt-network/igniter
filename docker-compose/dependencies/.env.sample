# EXAMPLE CONFIGURATION ONLY, provided "as is" without warranty.
# You are solely responsible for securing your own deployment.
# A real deployment runs either a provider or a middleman, not both.
# See docker-compose/README.md#security--usage-notice before using it with real keys or funds.
# Compose
COMPOSE_PROJECT_NAME=igniter-dependencies

# Temporal.io
TEMPORAL_VERSION=1.28.1.0
TEMPORAL_TOOLS_VERSION=1.28.1-tctl-1.18.4-cli-1.4.1
TEMPORAL_UI_VERSION=2.39.0

# Postgresql
POSTGRESQL_VERSION=16.3-alpine
# Bootstrap superuser. Used only inside the postgresql container (and by you,
# for maintenance). No app and no Temporal server receives it.
POSTGRES_USER=igniter
# Generate each password with `openssl rand -hex 32`. Every one is required:
# compose refuses to start while any of them is empty.
POSTGRES_PASSWORD=
# Login role `middleman`, owner of database `middleman`.
# Copy it to PGPASSWORD in apps/middleman/.env (with PGUSER="middleman").
MIDDLEMAN_DB_PASSWORD=
# Login role `provider`, owner of database `provider`.
# Copy it to PGPASSWORD in apps/provider/.env (with PGUSER="provider").
PROVIDER_DB_PASSWORD=
# Login role `temporal`, owner of databases `temporal` and `temporal_visibility`.
# Used only by the Temporal server in this stack.
TEMPORAL_DB_PASSWORD=
