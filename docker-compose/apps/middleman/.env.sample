# EXAMPLE CONFIGURATION ONLY, provided "as is" without warranty.
# You are solely responsible for securing your own deployment.
# A real deployment runs either a provider or a middleman, not both.
# See docker-compose/README.md#security--usage-notice before using it with real keys or funds.
# Compose
COMPOSE_PROJECT_NAME=igniter-middleman
# Image version for ghcr.io/pokt-network/middleman and middleman-workflows.
# Pin a release (https://github.com/pokt-network/igniter/releases) and bump it
# on every upgrade; never use `latest`. To also pin the exact image bytes, append
# the digest: IGNITER_VERSION=0.23.0@sha256:<digest> (shown on the package page,
# or by `docker buildx imagetools inspect ghcr.io/pokt-network/middleman:0.23.0`).
IGNITER_VERSION=0.23.0

# Nextjs
NODE_ENV="production"
# LogTape levels: trace|debug|info|warning|error|fatal (note "warning", not "warn"). Default: debug
LOG_LEVEL="info"

# Temporal.io
TEMPORAL_URL="temporal:7233"
TEMPORAL_NAMESPACE="middleman"
TEMPORAL_TASK_QUEUE="middleman-operations"
TEMPORAL_WORKFLOW_RETENTION="604800"

# Postgresql
PGHOST="postgresql"
# This app's own role, NOT the superuser. Created by
# dependencies/postgresql/init-roles.sh; owns database "middleman" only.
PGUSER="middleman"
# Must match MIDDLEMAN_DB_PASSWORD in dependencies/.env
PGPASSWORD=""
DB_NAME="middleman"
DATABASE_URL="postgres://${PGUSER}:${PGPASSWORD}@${PGHOST}:5432/${DB_NAME}?sslmode=disable"

# CometBFT RPC URL — used as a one-time seed for the DB on first boot.
# Once the setup form is completed, the DB value takes precedence.
# The API URL is configured via the setup form (not an env var).
POKT_RPC_URL="https://sauron-rpc.beta.infra.pocket.network"

PROVIDERS_CDN_URL="https://raw.githubusercontent.com/pokt-network/igniter-governance/refs/heads/main/{chainId}/provider.json"
# AUTH_TRUST_HOST is not read: auth.config.ts hardcodes `trustHost: true`, so
# the app always trusts the X-Forwarded-Host / X-Forwarded-Proto headers. Your
# reverse proxy MUST overwrite those headers (never pass a client's through),
# and the app port must never be reachable except through that proxy.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
CHAIN_ID="pocket-beta"
BLOCKCHAIN_PROTOCOL="shannon"
# Pocket Network Wallet address that will be used to login into the admin website
OWNER_IDENTITY="CHANGEME"
OWNER_EMAIL="change-this@example.com"
MINIMUM_STAKE_BUFFER="500000000"

# How to get it? `openssl rand -hex 24` (website session encryption)
AUTH_SECRET=""
# Pocket Network (shannon) private key (sign requests sent to providers)
# How to get it? `openssl rand -hex 32`
# USE A DEDICATED KEY THAT HOLDS NO FUNDS. It is stored here in plaintext and its
# public key is published in the governance registry, so the address it derives is
# public. Never reuse the private key of a wallet holding POKT, and never fund it.
APP_IDENTITY=""
# Coin market cap (used to display coin value to the users)
# Ref: https://coinmarketcap.com/api/documentation/v1/
COIN_MARKET_CAP_API_KEY="CHANGEME"

# Schedule watchdog (self-heal for Temporal schedules)
SCHEDULE_WATCHDOG_ENABLED="true"
SCHEDULE_WATCHDOG_MODE="enforce"
SCHEDULE_WATCHDOG_TICK="30s"
SCHEDULE_WATCHDOG_MIN_AGE="3m"
SCHEDULE_WATCHDOG_MISSED_FIRINGS="5"
SCHEDULE_WATCHDOG_MAX_HEAL_ATTEMPTS="5"
SCHEDULE_WATCHDOG_RECREATE_AFTER="2"

# Secret-at-rest encryption for notification channel credentials (webhook URL,
# bot token, SMTP password). USE A DIFFERENT KEY THAN PROVIDER.
# How to get it? `openssl rand -hex 32`.
NOTIFICATION_ENCRYPTION_KEY=""
# SSRF egress allowlist for notification channels. By default the guard refuses
# to deliver to private/loopback/link-local hosts (blocks an authenticated user
# from steering the server at internal services or 169.254.169.254). Set this to
# trust the internal targets YOU operate — comma/space separated host literals,
# IPs, or CIDRs, e.g. "10.0.0.0/8, mailpit, localhost". Leave empty for the
# strict default. Must be set on both middleman and middleman-workflows.
NOTIFICATION_EGRESS_ALLOWLIST=""
