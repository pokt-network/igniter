custom_build(
    ref='localhost:5001/middleman-workflows',
    command='./k8s/docker/build.sh middleman-workflows',
    dir='../../../',
    deps=['../../../apps/middleman-workflows', '../../../packages'],
    ignore=['node_modules', '**/node_modules', '**/dist', '**/*.test.ts', '**/__fixtures__'],
    live_update=[
      sync('../../../apps/middleman-workflows', '/app/apps/middleman-workflows'),
      sync('../../../packages', '/app/packages'),
      run(
        'pnpm install',
        trigger=[
          '../../../package.json',
          '../../../apps/**/package.json',
          '../../../packages/**/package.json'
        ]
      ),
      run(
        'pnpm exec turbo run build --filter=@igniter/middleman-workflows',
        trigger=[
          '../../../apps/middleman-workflows',
          '../../../packages'
        ]
      ),
      run('echo "last update is: $(date)" > /app/apps/middleman-workflows/trigger.update')
    ]
)

# decode kustomize output so we can patch env vars when localnet is enabled
objects = decode_yaml_stream(kustomize("./overlays/dev"))

LOCALNET_ENABLED = os.getenv('LOCALNET_ENABLED', '') == 'true'

for o in objects:
    if o['metadata']['name'] == 'middleman-workflows-config':
        o['data']['PROVIDERS_CDN_URL'] = 'http://governance-nginx.default.svc.cluster.local/providers.json'
        if LOCALNET_ENABLED:
            o['data']['POKT_RPC_URL'] = 'http://validator:26657'
        break

k8s_yaml(encode_yaml_stream(objects), allow_duplicates=False)

deps = ["middleman", "governance-nginx"]
if LOCALNET_ENABLED:
    deps.append("owner-fund")

k8s_resource(
    "middleman-workflows",
    extra_pod_selectors=[{"app": "middleman", "component": "workflows"}],
    objects=['middleman-workflows-config:configmap'],
    labels=['apps'],
    resource_deps=deps,
)
