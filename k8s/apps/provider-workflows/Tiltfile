custom_build(
    ref='localhost:5001/provider-workflows',
    command='./k8s/docker/build.sh provider-workflows',
    dir='../../../',
    deps=['../../../apps/provider-workflows', '../../../packages'],
    ignore=['node_modules', '**/node_modules', '**/dist', '**/*.test.ts', '**/__fixtures__'],
    live_update=[
      sync('../../../apps/provider-workflows', '/app/apps/provider-workflows'),
      sync('../../../packages', '/app/packages'),
      run(
        'pnpm install',
        trigger=[
          '../../../package.json',
          '../../../apps/**/package.json',
          '../../../packages/**/package.json'
        ]
      ),
      run(
        'pnpm exec turbo run build --filter=@igniter/provider-workflows',
        trigger=[
          '../../../apps/provider-workflows',
          '../../../packages'
        ]
      ),
      run('echo "last update is: $(date)" > /app/apps/provider-workflows/trigger.update')
    ]
)

# decode kustomize output so we can patch env vars when localnet is enabled
objects = decode_yaml_stream(kustomize("./overlays/dev"))

LOCALNET_ENABLED = os.getenv('LOCALNET_ENABLED', '') == 'true'

# Schedule watchdog (Temporal self-heal): only inject vars actually set in the
# env so unset ones fall back to the code defaults in packages/temporal.
WATCHDOG_ENV_VARS = [
    'SCHEDULE_WATCHDOG_ENABLED',
    'SCHEDULE_WATCHDOG_MODE',
    'SCHEDULE_WATCHDOG_TICK',
    'SCHEDULE_WATCHDOG_MIN_AGE',
    'SCHEDULE_WATCHDOG_MISSED_FIRINGS',
    'SCHEDULE_WATCHDOG_MAX_HEAL_ATTEMPTS',
    'SCHEDULE_WATCHDOG_RECREATE_AFTER',
]

for o in objects:
    if o['metadata']['name'] == 'provider-workflows-config':
        o['data']['DELEGATORS_CDN_URL'] = 'http://governance-nginx.default.svc.cluster.local/delegators.json'
        if LOCALNET_ENABLED:
            o['data']['POKT_RPC_URL'] = 'http://validator:26657'
        for var in WATCHDOG_ENV_VARS:
            val = os.getenv(var, '')
            if val != '':
                o['data'][var] = val
        break

k8s_yaml(encode_yaml_stream(objects), allow_duplicates=False)

deps = ["provider", "governance-nginx"]
if LOCALNET_ENABLED:
    deps.append("owner-fund")

k8s_resource(
    "provider-workflows",
    extra_pod_selectors=[{"app": "provider", "component": "workflows"}],
    objects=['provider-workflows-config:configmap'],
    labels=['apps'],
    resource_deps=deps,
)
