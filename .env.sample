# --- Middleman identity ---

# Maps to OWNER_IDENTITY in the middleman app (done by tilt)
MIDDLEMAN_OWNER_IDENTITY=

# Maps to APP_IDENTITY in the middleman app — private key used to sign requests to provider
MIDDLEMAN_APP_IDENTITY=

# --- Provider identity ---

# Maps to OWNER_IDENTITY in the provider app (done by tilt)
PROVIDER_OWNER_IDENTITY=

# Maps to APP_IDENTITY in the provider app — private key used to sign responses to middleman
PROVIDER_APP_IDENTITY=

# --- Staking ---

# Buffer in uPOKT removed from minimum stake on chain to allow nodes to operate after slashes
MINIMUM_STAKE_BUFFER=500000000

# --- Governance ---
# Local nginx serves governance JSON files so apps can discover each other in dev.
# Sample files are available at k8s/tools/governance/ — copy them and update the identity values:
#
#   cp k8s/tools/governance/delegators.sample.json k8s/tools/governance/delegators.json
#   cp k8s/tools/governance/providers.sample.json k8s/tools/governance/providers.json
#
# The .json files are gitignored so your local config won't be committed.
#
# For each type, set EITHER the _JSON (inline) or _JSON_FILE (path) variable, not both.
# If neither is set, an empty array [] is served.

# Inline JSON or file path for delegator governance (consumed by provider app)
DELEGATOR_JSON=
DELEGATOR_JSON_FILE=k8s/tools/governance/delegators.json

# Inline JSON or file path for provider governance (consumed by middleman app)
PROVIDER_JSON=
PROVIDER_JSON_FILE=k8s/tools/governance/providers.json
